---
layout: null
title: "RSS Feed"
permalink: /feed.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="{{ site.url }}{{ site.baseurl }}/assets/xslt/rss.xslt" ?>
<?xml-stylesheet type="text/css" href="{{ site.url }}{{ site.baseurl }}/assets/css/rss.css" ?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
	<channel>
		<title>{{ site.title | xml_escape }}</title>
		<description>{{ site.description | xml_escape }}</description>
		<link>{{ site.url }}{{ site.baseurl }}/</link>
		<atom:link href="{{ site.url }}{{ site.baseurl }}{{ page.url }}" rel="self" type="application/rss+xml" />
		<lastBuildDate>{{ site.time | date: "%a, %d %b %Y %H:%M:%S %z" }}</lastBuildDate>

		{%- assign All_Articles = site.content_articles -%}
		{%- assign All_Match_Days = site.content_match_days -%}

		{%- if jekyll.environment == "production" -%}
			{%- assign Visible_Articles = All_Articles | where_exp: "Item", "Item.published != false" -%}
			{%- assign Visible_Match_Days = All_Match_Days | where_exp: "Item", "Item.published != false" -%}
		{%- else -%}
			{%- assign Visible_Articles = All_Articles -%}
			{%- assign Visible_Match_Days = All_Match_Days -%}
		{%- endif -%}

		{%- assign Latest_Items = Visible_Articles | concat: Visible_Match_Days | sort: "date" | reverse -%}

		{% for Item in Latest_Items limit:10 %}
			<item>
				<title>{{ Item.title | strip_html | strip_newlines | xml_escape }}</title>
				<link>{{ site.url }}{{ site.baseurl }}{{ Item.url }}</link>
				<pubDate>{{ Item.date | date: "%a, %d %b %Y %H:%M:%S %z" }}</pubDate>

				<description><![CDATA[
					{% if Item.hero.file %}
						<p>
							<img src="{{ Item.hero.file | relative_url }}" alt="{{ Item.title | strip_html | escape }}" />
						</p>
					{% endif %}

					{% if Item.teaser and Item.teaser != "" %}
						<p>{{ Item.teaser | strip_html | strip_newlines }}</p>
					{% else %}
						<p>{{ Item.content | strip_html | strip_newlines | truncatewords: 60 }}</p>
					{% endif %}
				]]></description>

				{% if Item.hero.file %}
					<enclosure
						url="{{ Item.hero.file | absolute_url }}"
						type="image/webp"
					/>
				{% endif %}

				<guid isPermaLink="true">{{ site.url }}{{ site.baseurl }}{{ Item.url }}</guid>
			</item>
		{% endfor %}
	</channel>
</rss>
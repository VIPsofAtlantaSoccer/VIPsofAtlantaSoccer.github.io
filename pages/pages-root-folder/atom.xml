---
layout: null
title: "Atom Feed"
permalink: /atom.xml
---
<?xml version="1.0" encoding="utf-8"?>
<?xml-stylesheet type="text/xsl" href="{{ site.url }}{{ site.baseurl }}/assets/xslt/atom.xslt" ?>
<?xml-stylesheet type="text/css" href="{{ site.url }}{{ site.baseurl }}/assets/css/atom.css" ?>
<feed xmlns="http://www.w3.org/2005/Atom">
	<id>{{ site.url }}{{ site.baseurl }}/</id>
	<title>{{ site.title | xml_escape }}</title>
	<updated>{{ site.time | date_to_xmlschema }}</updated>
	<subtitle>{{ site.description | xml_escape }}</subtitle>

	{% if site.author %}
		{% assign Site_Author = site.data.authors[site.author] %}
		<author>
			{% if Site_Author.name %}
				<name>{{ Site_Author.name | xml_escape }}</name>
			{% else %}
				<name>{{ site.author | xml_escape }}</name>
			{% endif %}
			{% if Site_Author.email %}
				<email>{{ Site_Author.email | xml_escape }}</email>
			{% endif %}
			{% if Site_Author.uri %}
				<uri>{{ Site_Author.uri | xml_escape }}</uri>
			{% endif %}
		</author>
	{% endif %}

	<link href="{{ site.url }}{{ site.baseurl }}{{ page.url }}" rel="self" type="application/atom+xml" />
	<link href="{{ site.url }}{{ site.baseurl }}/" rel="alternate" type="text/html" />

	<generator uri="https://jekyllrb.com" version="{{ jekyll.version }}">Jekyll</generator>

	{%- assign All_Articles = site.content_articles -%}
	{%- assign All_Match_Days = site.content_match_days -%}

	{%- if jekyll.environment == "production" -%}
		{%- assign Visible_Articles = All_Articles | where_exp: "Item", "Item.published != false" -%}
		{%- assign Visible_Match_Days = All_Match_Days | where_exp: "Item", "Item.published != false" -%}
	{%- else -%}
		{%- assign Visible_Articles = All_Articles -%}
		{%- assign Visible_Match_Days = All_Match_Days -%}
	{%- endif -%}

	{%- assign Latest_Items = Visible_Articles | concat: Visible_Match_Days | sort: "date" | reverse -%}

	{% for Item in Latest_Items limit:10 %}
		<entry>
			<id>{{ site.url }}{{ site.baseurl }}{{ Item.url }}</id>
			<title>{{ Item.title | strip_html | strip_newlines | xml_escape }}</title>
			<link href="{{ site.url }}{{ site.baseurl }}{{ Item.url }}" rel="alternate" type="text/html" title="{{ Item.title | xml_escape }}" />
			<updated>{{ Item.date | date_to_xmlschema }}</updated>
			<published>{{ Item.date | date_to_xmlschema }}</published>

			{% if Item.author %}
				{% assign Item_Author = site.data.authors[Item.author] %}
				<author>
					{% if Item_Author.name %}
						<name>{{ Item_Author.name | xml_escape }}</name>
					{% else %}
						<name>{{ Item.author | xml_escape }}</name>
					{% endif %}
					{% if Item_Author.email %}
						<email>{{ Item_Author.email | xml_escape }}</email>
					{% endif %}
					{% if Item_Author.uri %}
						<uri>{{ Item_Author.uri | xml_escape }}</uri>
					{% endif %}
				</author>
			{% endif %}

			{% if Item.teaser and Item.teaser != "" %}
				<summary>{{ Item.teaser | strip_html | strip_newlines | xml_escape }}</summary>
			{% else %}
				<summary>{{ Item.content | strip_html | strip_newlines | truncatewords: 60 | xml_escape }}</summary>
			{% endif %}

			{% capture Item_Content %}
				{% if Item.hero.file %}
					<p>
						<img
							src="{{ Item.hero.file | relative_url }}"
							alt="{{ Item.title | strip_html | escape }}"
						/>
					</p>
				{% endif %}

				{{ Item.content }}
			{% endcapture %}

			<content type="html" xml:base="{{ site.url }}{{ site.baseurl }}{{ Item.url }}">{{ Item_Content | xml_escape }}</content>

			{% for Category in Item.categories %}
				<category term="{{ Category | xml_escape }}" />
			{% endfor %}

			{% for Tag in Item.tags %}
				<category term="{{ Tag | xml_escape }}" />
			{% endfor %}
		</entry>
	{% endfor %}
</feed>